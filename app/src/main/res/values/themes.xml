<resources>
    <!-- Compose draws the real theme; this is just the launch/window theme so the
         app doesn't flash white before the first frame. -->
    <style name="Theme.RouteAhead" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
</resources>
